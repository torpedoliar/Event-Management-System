# Database backups
*.sql
backup_*.sql
db_backup_*.sql
# PENTING: migrasi Prisma WAJIB ikut ter-commit.
# Tanpa pengecualian ini, repo bersih tidak punya folder migrasi sama sekali,
# sehingga `prisma migrate deploy` menjadi no-op dan skema tidak pernah dibuat.
!apps/backend/prisma/migrations/**/*.sql
# Arsip migrasi lama (tidak dieksekusi, hanya untuk melestarikan riwayat)
!apps/backend/prisma/_migrations_legacy_*/**/*.sql
# Fixture untuk latihan drill backup (dipakai scripts/verify-backup.sh)
!scripts/drill-seed.sql
# Archive files
*.7z
*.zip
*.rar
# Backup folders
backup_*/
.claude/

# Playwright CLI session artifacts
.playwright-cli/
