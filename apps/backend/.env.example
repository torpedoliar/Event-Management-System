# Backend Environment
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/guest_registry?schema=public"
JWT_SECRET="replace-with-long-random-secret"
CORS_ORIGIN="*"

# HTTPS Configuration (Optional)
# Set USE_HTTPS=true to enable HTTPS mode
USE_HTTPS=false
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt
