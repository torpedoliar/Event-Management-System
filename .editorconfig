# EditorConfig - menyelaraskan gaya dasar antar editor.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Skrip Windows WAJIB CRLF agar `goto` dan label batch tidak rusak.
[*.{bat,cmd}]
end_of_line = crlf

# PowerShell juga lebih aman CRLF di Windows.
[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
